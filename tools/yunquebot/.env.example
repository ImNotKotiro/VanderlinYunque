# Copia este archivo a .env y rellena los valores.
# La consola y el selftest no necesitan el token de Discord.

# Servidor DreamDaemon. El bot le pregunta ?status por el puerto del juego.
BYOND_HOST=127.0.0.1
BYOND_PORT=1337
BYOND_TIMEOUT=5

# Nombre que aparece en los mensajes.
SERVER_NAME=Yunque

# Segundos entre avisos automaticos. 900 = 15 minutos. 0 lo desactiva.
UPDATE_INTERVAL_SECONDS=900

# Mínimo para el aviso automático. Solo se publica si hay MÁS jugadores que este número.
# 5 = a partir de 6. 0 = a partir de 1. -1 = también con el servidor vacío.
MIN_PLAYERS_TO_ANNOUNCE=5

# Solo hacen falta para: python yunquebot.py discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Si lo rellenas, /estado aparece al momento en ese servidor.
DISCORD_GUILD_ID=
